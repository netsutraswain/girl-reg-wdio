{
  "name": "gril-reg-wdio",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "if exist allure-results rmdir /s /q allure-results && if exist allure-report rmdir /s /q allure-report",
    "wdio": "npm run clean && wdio run ./wdio.conf.ts",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test:report": "npm run wdio && npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "expect-webdriverio": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
